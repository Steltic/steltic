{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Steltic/steltic_openBIM/contracts/bim_package.schema.json",
  "title": "Steltic physical-data package v1",
  "$defs": {
    "point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "axis": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/point"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "finding": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "error",
            "needs_input"
          ]
        },
        "entity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "code",
        "message",
        "severity",
        "entity_ids"
      ],
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "candidate",
            "recovered",
            "declared"
          ]
        },
        "axis": {
          "$ref": "#/$defs/axis"
        },
        "local_y": {
          "anyOf": [
            {
              "$ref": "#/$defs/point"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "material_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "analysis_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "analysis_coordinate_mapping": {
          "type": "object",
          "properties": {
            "axis_order": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              }
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "axis_order",
            "basis"
          ],
          "additionalProperties": false,
          "description": "Explicit relabelling of saved analysis coordinates into the physical reference frame: physical[i]=analysis[axis_order[i]]. No scaling, translation, rotation angles or omitted axes. Exact interval, extent and coverage checks still apply."
        },
        "reference_line": {
          "type": [
            "string",
            "null"
          ]
        },
        "end_offsets": {
          "anyOf": [
            {
              "$ref": "#/$defs/axis"
            },
            {
              "type": "null"
            }
          ]
        },
        "analysis_segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "analysis_id": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "end": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "analysis_id",
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        "analysis_component_roles": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 2,
          "additionalProperties": {
            "enum": [
              "axial",
              "flexural"
            ]
          },
          "description": "Explicit coincident solver components of one shaft; checked against source element types, areas and the complete reference axis."
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "axis",
        "analysis_ids"
      ],
      "additionalProperties": true
    },
    "panel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "candidate",
            "recovered",
            "declared"
          ]
        },
        "vertices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "minItems": 3
        },
        "thickness": {
          "type": [
            "number",
            "null"
          ]
        },
        "material_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "vertices"
      ],
      "additionalProperties": true
    },
    "opening": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "host_id": {
          "type": "string",
          "minLength": 1
        },
        "vertices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "minItems": 3
        }
      },
      "required": [
        "id",
        "host_id",
        "vertices"
      ],
      "additionalProperties": true
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "candidate",
            "recovered",
            "declared"
          ]
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "profile_id": {
                "type": "string",
                "minLength": 1
              },
              "offset": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "rotation_deg": {
                "type": "number"
              }
            },
            "required": [
              "profile_id",
              "offset",
              "rotation_deg"
            ],
            "additionalProperties": true
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "status",
        "family",
        "dimensions"
      ],
      "additionalProperties": true
    },
    "material": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "specification": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "specification"
      ],
      "additionalProperties": true
    },
    "joint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "point": {
          "$ref": "#/$defs/point"
        },
        "member_ends": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "member_id": {
                "type": "string",
                "minLength": 1
              },
              "end": {
                "enum": [
                  "start",
                  "end"
                ]
              },
              "joint_offset": {
                "$ref": "#/$defs/point"
              }
            },
            "required": [
              "member_id",
              "end"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "member_id": {
                "type": "string",
                "minLength": 1
              },
              "station": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "offset": {
                "$ref": "#/$defs/point"
              }
            },
            "required": [
              "member_id",
              "station"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "point",
        "member_ends"
      ],
      "additionalProperties": true
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "box"
            },
            "origin": {
              "$ref": "#/$defs/point"
            },
            "size": {
              "$ref": "#/$defs/point"
            },
            "x_axis": {
              "$ref": "#/$defs/point"
            },
            "y_axis": {
              "$ref": "#/$defs/point"
            }
          },
          "required": [
            "type",
            "origin",
            "size",
            "x_axis",
            "y_axis"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "cylinder"
            },
            "origin": {
              "$ref": "#/$defs/point"
            },
            "axis": {
              "$ref": "#/$defs/point"
            },
            "length": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "type",
            "origin",
            "axis",
            "length",
            "radius"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "extruded_profile"
            },
            "origin": {
              "$ref": "#/$defs/point"
            },
            "axis": {
              "$ref": "#/$defs/point"
            },
            "local_y": {
              "$ref": "#/$defs/point"
            },
            "profile_id": {
              "type": "string",
              "minLength": 1
            },
            "length": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "type",
            "origin",
            "axis",
            "local_y",
            "profile_id",
            "length"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "polyline"
            },
            "points": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/point"
              },
              "minItems": 2
            }
          },
          "required": [
            "type",
            "points"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "mesh"
            },
            "faces": {
              "type": "array",
              "minItems": 4,
              "items": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "$ref": "#/$defs/point"
                }
              }
            }
          },
          "required": [
            "type",
            "faces"
          ],
          "additionalProperties": false
        }
      ]
    },
    "connection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "joint_id": {
          "type": "string",
          "minLength": 1
        },
        "design_record_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "scope": {
          "enum": [
            "designed",
            "delegated",
            "coordination"
          ]
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "material_id": {
                "type": "string",
                "minLength": 1
              },
              "geometry": {
                "$ref": "#/$defs/geometry"
              },
              "parameters": {
                "type": "object"
              }
            },
            "required": [
              "id",
              "kind",
              "material_id",
              "geometry"
            ],
            "additionalProperties": true
          },
          "minItems": 0
        },
        "detail_ref": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "revision"
          ],
          "additionalProperties": true
        },
        "responsible_party": {
          "type": "string",
          "minLength": 1
        },
        "representation": {
          "type": "string",
          "minLength": 1
        },
        "assembly_instance": {
          "type": "object",
          "properties": {
            "template_id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "origin": {
              "$ref": "#/$defs/point"
            },
            "x_axis": {
              "$ref": "#/$defs/point"
            },
            "y_axis": {
              "$ref": "#/$defs/point"
            },
            "bindings": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "template_id",
            "revision",
            "origin",
            "x_axis",
            "y_axis",
            "bindings"
          ],
          "additionalProperties": false
        },
        "source_record_selections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "record_id": {
                "type": "string",
                "minLength": 1
              },
              "field": {
                "enum": [
                  "selection",
                  "components"
                ]
              },
              "clause": {
                "type": "string",
                "pattern": "^(base|floors|top|exterior bases|interior hss[0-9.x/]+ columns)$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "level": {
                "type": "integer",
                "minimum": 1
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "record_id",
              "field",
              "clause",
              "text",
              "level",
              "basis"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "joint_id",
        "design_record_ids",
        "scope"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "enum": [
                  "designed",
                  "delegated"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "design_record_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "interface": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "responsible_party": {
          "type": "string",
          "minLength": 1
        },
        "representation": {
          "type": "string",
          "minLength": 1
        },
        "detail_ref": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "revision"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "id",
        "scope",
        "responsible_party",
        "representation",
        "detail_ref"
      ],
      "additionalProperties": true
    },
    "referenceSystem": {
      "type": "object",
      "required": [
        "basis",
        "levels",
        "grids"
      ],
      "additionalProperties": false,
      "properties": {
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "source_ifc_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "level",
              "elevation_in"
            ],
            "additionalProperties": false,
            "properties": {
              "level": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "elevation_in": {
                "type": "number"
              }
            }
          }
        },
        "grids": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "direction",
              "points_in"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "direction": {
                "enum": [
                  "U",
                  "V",
                  "W"
                ]
              },
              "points_in": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "#/$defs/point"
                }
              }
            }
          }
        }
      }
    }
  },
  "type": "object",
  "properties": {
    "schema": {
      "const": "steltic.bim_package"
    },
    "schema_version": {
      "const": "1.0"
    },
    "building_id": {
      "type": "string",
      "minLength": 1
    },
    "module": {
      "enum": [
        "HR",
        "CFS"
      ]
    },
    "units": {
      "const": {
        "length": "in",
        "force": "kip",
        "stress": "ksi"
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "module": {
          "enum": [
            "HR",
            "CFS"
          ]
        },
        "package_file": {
          "type": "string",
          "minLength": 1
        },
        "source_files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "engine_files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "mode": {
          "const": "model_only_replay"
        },
        "analysis_executed": {
          "const": false
        },
        "exporter_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "producer_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "engine_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "physical_inputs": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "const": "physical_inputs.json"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "revision",
            "sha256"
          ],
          "additionalProperties": false
        },
        "model_capture": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "native_configuration",
                "legacy_missing_dependency",
                "portable_checked_model"
              ]
            },
            "independent_configuration_rebuild": {
              "type": "boolean"
            },
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "basis": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "configuration_dependency_missing": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "independent_configuration_rebuild"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "module",
        "package_file",
        "source_files",
        "engine_files",
        "mode",
        "analysis_executed",
        "producer_revision"
      ],
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "point": {
                "$ref": "#/$defs/point"
              }
            },
            "required": [
              "id",
              "point"
            ],
            "additionalProperties": true
          },
          "minItems": 0
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "node_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 2
              }
            },
            "required": [
              "id",
              "node_ids"
            ],
            "additionalProperties": true
          },
          "minItems": 0
        }
      },
      "required": [
        "nodes",
        "elements"
      ],
      "additionalProperties": true
    },
    "physical": {
      "type": "object",
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          },
          "minItems": 0
        },
        "panels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/panel"
          },
          "minItems": 0
        },
        "openings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opening"
          },
          "minItems": 0
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profile"
          },
          "minItems": 0
        },
        "materials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/material"
          },
          "minItems": 0
        },
        "joints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/joint"
          },
          "minItems": 0
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connection"
          },
          "minItems": 0
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interface"
          },
          "minItems": 0
        },
        "analysis_only": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "analysis_id": {
                "type": "string",
